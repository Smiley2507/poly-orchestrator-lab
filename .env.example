# ShopNow — local development environment variables
# Copy to .env before running Docker Compose:
#     cp .env.example .env
#
# WARNING: these are LOCAL DEVELOPMENT credentials only.
# Never reuse them outside a local machine. In AWS these values come from
# Secrets Manager / SSM Parameter Store, not from a committed file.

# ---- PostgreSQL (local: the "postgres" Compose service; later: RDS endpoint) ----
DATABASE_NAME=shopnow
DATABASE_USER=shopnow
DATABASE_PASSWORD=shopnow_local_dev

# ---- Redis (local: the "redis" Compose service; later: ElastiCache endpoint) ----
REDIS_DB=0
CACHE_TTL_SECONDS=60

# ---- Ports published on the host machine ----
BACKEND_PORT=8000
FRONTEND_HOST_PORT=3000

# ---- Backend CORS (comma-separated origins, or * for local dev) ----
CORS_ORIGINS=*

# ---- Frontend API base URL (build-time) ----
# Leave empty for Docker Compose: the browser calls the frontend's own origin
# and nginx proxies /api and /health to the backend service.
# Set it only if the frontend must call the backend on a different origin,
# e.g. VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
